# CAMP(US) FIX — Institutional Production Environment Configuration

# Server Port
PORT=8080

# Environment: development or production
CAMPUS_ENV=production

# Cryptographic Secret for Bearer Tokens & Session Verification
SESSION_SIGNATURE_SECRET=your_strong_random_secret_key_here

# Persistent Database File or Postgres URI
# If using SQLite (default):
DATABASE_URL=campus_fix.db
# If using external PostgreSQL in the cloud:
# DATABASE_URL=postgresql://user:password@host:5432/campus_fix

# Google OAuth 2.0 Credentials (Optional / Configured for institutional domain)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback

# Institution Settings
CAMPUS_NAME=National Institute of Technology
ADMIN_EMAIL=dean.infra@campus.edu
EMERGENCY_HOTLINE=2222
